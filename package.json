{
  "name": "wolf-den-site",
  "version": "1.0.0",
  "description": "The Wolf Den local game store website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --status",
    "app:publish": "node scripts/publish-app.mjs",
    "app:publish:market": "node scripts/publish-app.mjs --app market",
    "lint:undef": "eslint . -c eslint.undef.mjs --no-config-lookup",
    "check:dead-components": "node scripts/check-dead-components.mjs",
    "check:styled-jsx": "node scripts/check-styled-jsx.mjs",
    "check:guide": "node scripts/check-guide.mjs",
    "check:art": "node scripts/check-image-paths.mjs",
    "check:arena": "node scripts/check-arena.mjs",
    "check:sim": "node scripts/check-sim-drift.mjs",
    "check:ascension": "node --experimental-loader ./scripts/lib/alias-loader.mjs scripts/check-ascension.mjs",
    "check:sets": "node scripts/check-sets.mjs",
    "check:tree": "node scripts/check-tree.mjs",
    "check:hook-deps": "node scripts/check-hook-deps.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.5.0",
    "bcryptjs": "^3.0.3",
    "firebase-admin": "^13.10.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "next": "^16.2.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.7.0",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4"
  }
}
