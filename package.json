{
    "name": "wolf-den-site",
    "version": "1.0.0",
    "description": "The Wolf Den local game store website",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "db:migrate": "node scripts/migrate.js",
        "db:migrate:status": "node scripts/migrate.js --status",
        "app:publish": "node scripts/publish-app.mjs",
        "app:publish:market": "node scripts/publish-app.mjs --app market",
        "lint:undef": "eslint . -c eslint.undef.mjs --no-config-lookup",
        "check:css": "node scripts/check-css.mjs",
        "audit:seeds": "node scripts/audit-seed-rates.mjs",
        "sim:road:me": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-road-me.mjs",
        "sim:arch:cal": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-archetype-cal.mjs",
        "sim:road:headroom": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-road-headroom.mjs",
        "sim:road:progress": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-road-progress.mjs",
        "grove:curve": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/grove-curve.mjs",
        "prove:reports": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/prove-reports-v2.mjs",
        "prove:year": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/prove-year-report.mjs",
        "prove:tax": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/prove-tax-position.mjs",
        "prove:forge": "node --import ./scripts/lib/register-loader.mjs scripts/prove-grove-forge.mjs",
        "prove:inventory": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/prove-ending-inventory.mjs",
        "sim:pvp": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-pvp.mjs",
        "arena:report": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/arena-report.mjs",
        "sim:road": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-played.mjs",
        "sim:ladder": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-ladder.mjs",
        "sim:classswap": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-classswap.mjs",
        "sim:skills": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-skills.mjs",
        "sim:boss-party": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/sim-boss-party.mjs",
        "watch:dupes": "node scripts/dupe-watch.mjs",
        "check:vercel": "node scripts/check-vercel-json.mjs",
        "check:collections": "node --import ./scripts/lib/register-loader.mjs scripts/check-collections.mjs",
        "check:polls": "node scripts/check-polls.mjs",
        "check:chrome": "node scripts/check-chrome-fanout.mjs",
        "check:grove": "node --import ./scripts/lib/register-loader.mjs scripts/check-grove.mjs",
        "check:farm": "node scripts/check-farm.mjs",
        "check:grove-curve": "node scripts/check-grove-curve.mjs",
        "check:grove-roll": "node --import ./scripts/lib/register-loader.mjs scripts/check-grove-roll.mjs",
        "check:grove-physics": "node --import ./scripts/lib/register-loader.mjs scripts/check-grove-physics.mjs",
        "check:grove-pet": "node --import ./scripts/lib/register-loader.mjs scripts/check-grove-pet.mjs",
        "check:grove-loot": "node --import ./scripts/lib/register-loader.mjs scripts/check-grove-loot.mjs",
        "check:grove-rework": "node --import ./scripts/lib/register-loader.mjs scripts/check-grove-rework.mjs",
        "grove:sprites": "node --import ./scripts/lib/register-loader.mjs scripts/grove-sprite-bounds.mjs",
        "gen:season-art": "node --import ./scripts/lib/register-loader.mjs scripts/gen-season-art.mjs",
        "mine:report": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/mine-report.mjs",
        "sheet:islands": "node --experimental-loader ./scripts/lib/app-loader.mjs scripts/island-sheet.mjs",
        "harness:vault": "node scripts/vault-harness.mjs",
        "prove:vault": "node --import ./scripts/lib/register-loader.mjs scripts/prove-vault.mjs",
        "check:craft-act": "node --import ./scripts/lib/register-loader.mjs scripts/check-craft-act.mjs",
        "check:gates": "node --import ./scripts/lib/register-loader.mjs scripts/check-gates.mjs",
        "check:acts": "node --import ./scripts/lib/register-loader.mjs scripts/check-acts.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "private": true,
    "dependencies": {
        "@dicebear/collection": "^9.4.2",
        "@dicebear/core": "^9.4.3",
        "@neondatabase/serverless": "^1.1.0",
        "@vercel/blob": "^2.5.0",
        "bcryptjs": "^3.0.3",
        "firebase-admin": "^13.10.0",
        "gsap": "^3.15.0",
        "leaflet": "^1.9.4",
        "next": "^16.2.4",
        "qrcode": "^1.5.4",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-icons": "^5.7.0",
        "resend": "^6.12.3",
        "sharp": "^0.34.5",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.4"
    }
}
