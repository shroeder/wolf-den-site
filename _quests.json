{
 "npcs": [
  {
   "id": "alder",
   "map": 1,
   "name": "Warden Alder",
   "role": "Keeper of the treeline",
   "line": "You're the first thing to come through here on purpose in a while."
  },
  {
   "id": "pell",
   "map": 1,
   "name": "Mossgatherer Pell",
   "role": "Collects what grows on the dead",
   "line": "Careful where you tread. Half of what's underfoot is still deciding."
  },
  {
   "id": "snare",
   "map": 1,
   "name": "The Snarefitter",
   "role": "Sets traps she never checks",
   "line": "I set forty lines out there. I'd like to know what's been walking into them."
  },
  {
   "id": "mub",
   "map": 2,
   "name": "Lampwright Mub",
   "role": "Farms the glow",
   "line": "Down here light is a crop. Mine's been failing and I'd like to know what's eating it."
  },
  {
   "id": "cart",
   "map": 2,
   "name": "The Blind Cartographer",
   "role": "Maps by sound",
   "line": "I don't need to see it. I need you to go there and make noise."
  },
  {
   "id": "odd",
   "map": 2,
   "name": "Spelunker Odd",
   "role": "Goes further than is sensible",
   "line": "Everything worth having is one chamber past where people stop."
  },
  {
   "id": "sil",
   "map": 3,
   "name": "Reedcutter Sil",
   "role": "Harvests the blades",
   "line": "The reeds cut back now. That's new, and I don't like new."
  },
  {
   "id": "priest",
   "map": 3,
   "name": "The Bog-Priest",
   "role": "Tends something under the water",
   "line": "It's not drowning if it meant to go under. Remember that."
  },
  {
   "id": "nim",
   "map": 3,
   "name": "Stiltwalker Nim",
   "role": "Never touches the ground",
   "line": "I've walked this marsh for eleven years and I've not had wet feet once."
  },
  {
   "id": "coble",
   "map": 4,
   "name": "Wrackpicker Coble",
   "role": "Works the tideline",
   "line": "Tide brings it, I sort it. Lately it's bringing things that sort themselves."
  },
  {
   "id": "keeper",
   "map": 4,
   "name": "The Line-Keeper",
   "role": "Decides where the coast ends",
   "line": "There's a line. Things on the far side of it are not my problem yet."
  },
  {
   "id": "oss",
   "map": 4,
   "name": "Netmender Oss",
   "role": "Mends what comes back torn",
   "line": "Nets come home with holes the shape of nothing I can name."
  },
  {
   "id": "mason",
   "map": 5,
   "name": "The Last Mason",
   "role": "Still repairing it",
   "line": "Somebody has to hold it up. It may as well be the one who remembers how."
  },
  {
   "id": "quell",
   "map": 5,
   "name": "Diver Quell",
   "role": "Goes down and comes back less",
   "line": "Everything valuable is at the bottom. So is everything that wants you there."
  },
  {
   "id": "vane",
   "map": 5,
   "name": "Archivist Vane",
   "role": "Reads what the water left",
   "line": "The writing survived. The people did not. I'd like to know why that order."
  },
  {
   "id": "dune",
   "map": 6,
   "name": "Assayer Dune",
   "role": "Tells fools from fortunes",
   "line": "Everyone brings me gold. Nobody brings me gold."
  },
  {
   "id": "gilt",
   "map": 6,
   "name": "The Gilt-Hunter",
   "role": "Still convinced",
   "line": "Dune's wrong. It's out here. I just haven't dug the right hole."
  },
  {
   "id": "kel",
   "map": 6,
   "name": "Sandwright Kel",
   "role": "Builds things the wind unbuilds",
   "line": "I've raised this marker nine times. Something keeps taking it down."
  },
  {
   "id": "rook",
   "map": 7,
   "name": "Cinderwarden Rook",
   "role": "Keeps the fire where it is",
   "line": "It's not out. It's waiting, and it's patient, and so am I."
  },
  {
   "id": "counter",
   "map": 7,
   "name": "The Ash-Counter",
   "role": "Measures how far it spread",
   "line": "I count what burned. The number is going up again."
  },
  {
   "id": "sol",
   "map": 7,
   "name": "Emberwright Sol",
   "role": "Works metal in live coals",
   "line": "Everything here is ruined except what the heat made better. Bring me the second kind."
  }
 ],
 "cols": [
  {
   "id": "thorn",
   "map": 1,
   "name": "Ringmaster Thorn",
   "line": "Twelve rooms of it, all at once, on the clock. Interested?"
  },
  {
   "id": "caller",
   "map": 2,
   "name": "The Pit-Caller",
   "line": "Shout down the hole. Whatever answers, you fight."
  },
  {
   "id": "dredge",
   "map": 3,
   "name": "Marshal Dredge",
   "line": "We drained a pit for this. Don't waste it."
  },
  {
   "id": "brin",
   "map": 4,
   "name": "Tidecaller Brin",
   "line": "Tide's out for two minutes. That's your two minutes."
  },
  {
   "id": "herald",
   "map": 5,
   "name": "The Drowned Herald",
   "line": "They still fill the stands. You just can't see them."
  },
  {
   "id": "vex",
   "map": 6,
   "name": "Goldmaster Vex",
   "line": "The purse is real, which makes this the only honest thing out here."
  },
  {
   "id": "kade",
   "map": 7,
   "name": "Ashmarshal Kade",
   "line": "The sand's warm. It's always warm. Go on."
  }
 ],
